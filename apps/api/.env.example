# ─────────────────────────────────────────────────────────
# ETA API — Production Environment Configuration Template
# PRD §103 V1 Launch Checklist
#
# Copy this file to .env and fill in real values.
# NEVER commit .env files — see root .gitignore.
# ─────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (PRD §62, §103)
# Ensure TLS 1.2+, retryWrites, and appropriate maxPoolSize (default 50)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/etaDB?retryWrites=true&w=majority&appName=eta-api

# Firebase Admin SDK (PRD §9.3, §103)
# From Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-production-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-production-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRODUCTION_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Frontend Origin for CORS (PRD §73, §103)
# Single authorized production domain or comma-separated origins
FRONTEND_URL=https://eta-web-omega.vercel.app

# Educational AI Configuration — PRD §93, §94, §103
# Supported providers: 'openai' (production), 'disabled' (maintenance/kill-switch), or 'mock' (test only)
AI_PROVIDER=openai
AI_API_KEY=sk-proj-your-production-openai-api-key
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_EMBEDDING_VERSION=v1
FEATURE_AI_STUDY_ASSISTANT=true

# Super Admin One-Time Bootstrap (PRD §103, §104)
# When a user with this email completes registration/sync, they are automatically
# provisioned with the SUPER_ADMIN role. Clear this variable after initial bootstrap.
SUPER_ADMIN_BOOTSTRAP_EMAIL=superadmin@eta.academy

# Scheduled / Cron Jobs Secret — PRD §103
# Required when calling /api/v1/cron/run or scheduled maintenance endpoints.
# Set a high-entropy secret (min 16 chars). Pass via Authorization: Bearer <secret>
CRON_SECRET=production-secure-cron-secret-change-me-32chars

# Private Document & File Upload Policy — PRD §103, §104
# Disabled by default for controlled beta safety.
# Reject direct external URLs for admissions documents, assignment attachments, and message files.
FEATURE_PRIVATE_FILE_UPLOADS=false


